universe = vanilla
executable = scripts/run_generated_reverse_null_chunk.sh
arguments = $(ProcId) 100

output = logs/generated_reverse_null_120m_$(ClusterId)_$(ProcId).out
error  = logs/generated_reverse_null_120m_$(ClusterId)_$(ProcId).err
log    = logs/generated_reverse_null_120m_$(ClusterId).log

+JobFlavour = "workday"
request_cpus = 1
request_memory = 3000
request_disk = 500000
should_transfer_files = NO

queue 100
